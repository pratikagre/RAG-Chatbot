# ==========================================
# Agentic AI RAG Chatbot - Environment Config
# ==========================================

# OpenAI API Key (Required for Embeddings and LLM Generation)
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=agentic-ai-index
# Cloud provider & region for Pinecone Serverless Index (default: aws / us-east-1)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Model Parameters
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Retrieval & Ingestion Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
PDF_PATH=data/Ebook-Agentic-AI.pdf

# Server Settings
HOST=0.0.0.0
PORT=8000
